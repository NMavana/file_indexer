{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Indexer",
  "version": "0.8.0",
  "identifier": "com.fileindexer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "File Indexer", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 560 }],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Indexez et recherchez vos fichiers localement"
  }
}
